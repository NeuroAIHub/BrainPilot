# BrainPilot Docker deployment — copy to `.env` and edit.
# `docker compose` auto-loads `.env` from this directory.

# --- Ports (both customizable; conflict → compose fails, change here) ---
BP_MAIN_PORT=9001        # main: backend + web UI (host-exposed)
BP_SANDBOX_PORT=8081     # sandbox: runtime service

# --- Network: bridge (default, isolated) | host (override file required) ---
# For host networking run:
#   docker compose -f docker-compose.yml -f docker-compose.host.yml up
BP_NETWORK=bridge

# --- Data directory (host path, bind-mounted into the sandbox) ---
BP_DATA_DIR=./brainpilot

# --- Provider key (passed to both containers) ---
ANTHROPIC_API_KEY=

# --- Third-party / custom model (optional) ---------------------------------
# By default BrainPilot uses Pi's built-in Anthropic endpoint. To target a
# third-party Anthropic-compatible gateway, set BOTH of these:
#   ANTHROPIC_BASE_URL=https://your-gateway.example.com/api
#   ANTHROPIC_MODEL=kimi-k2.6
# (ANTHROPIC_API_KEY above is sent as the gateway key.) Optionally tune limits:
#   ANTHROPIC_CONTEXT_WINDOW=262144   # default 200000
#   ANTHROPIC_MAX_TOKENS=8192         # default 8192
#
# Advanced (multi-provider, custom headers, openai-compatible, compat flags):
# write your own models.json (see models.example.json) and point to it:
#   BP_MODELS_JSON=./brainpilot/models.json
#   ANTHROPIC_MODEL=<model id from that file>
#   BP_MODEL_PROVIDER=<provider name>   # optional; default = file's first provider
# ---------------------------------------------------------------------------

# --- Deterministic mock mode for testing (1 = on, do not burn API quota) ---
BP_MOCK=

# --- Optional build acceleration (default = official sources) ---
# NPM_REGISTRY=https://registry.npmmirror.com
# APT_MIRROR=http://mirrors.aliyun.com
# HTTP_PROXY=
# HTTPS_PROXY=
