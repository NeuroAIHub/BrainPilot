{
  "name": "@brainpilot/backend-core",
  "version": "0.0.4",
  "license": "Apache-2.0",
  "type": "module",
  "description": "BrainPilot Backend — Hono REST+SSE proxy, serve web, Orchestrator abstraction (Docker/Local)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NeuroAIHub/BrainPilot.git",
    "directory": "packages/backend-core"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "start": "node ./dist/server.js"
  },
  "dependencies": {
    "@brainpilot/protocol": "^0.0.4",
    "@brainpilot/runtime": "^0.0.4",
    "@hono/node-server": "^1.13.0",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@types/dockerode": "^3.3.0"
  }
}
