{
	"name": "@brainpilot/pi-sdk",
	"version": "0.2.3",
	"description": "BrainPilot's pinned Pi 0.84.2 SDK with audited dependency backports",
	"type": "module",
	"piConfig": {
		"configDir": ".pi"
	},
	"bin": {
		"pi": "dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./rpc-entry": {
			"import": "./dist/rpc-entry.js"
		},
		"./client": {
			"types": "./dist/client/index.d.ts",
			"import": "./dist/client/index.js"
		}
	},
	"files": [
		"dist",
		"docs",
		"examples",
		"containerization.md",
		"CHANGELOG.md",
		"npm-shrinkwrap.json",
		"LICENSE",
		"UPSTREAM.md"
	],
	"scripts": {
		"build": "node ../../scripts/build-pi-sdk.mjs --check",
		"prepack": "node ../../scripts/build-pi-sdk.mjs --check"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "0.84.2",
		"@earendil-works/pi-ai": "0.84.2",
		"@earendil-works/pi-client": "0.84.2",
		"@earendil-works/pi-protocol": "0.84.2",
		"@earendil-works/pi-tui": "0.84.2",
		"@silvia-odwyer/photon-node": "0.3.4",
		"chalk": "5.6.2",
		"cross-spawn": "7.0.6",
		"diff": "8.0.4",
		"glob": "13.0.6",
		"grok-mermaid": "0.2.2",
		"highlight.js": "10.7.3",
		"hosted-git-info": "9.0.3",
		"ignore": "7.0.5",
		"jiti": "2.7.0",
		"minimatch": "10.2.5",
		"proper-lockfile": "4.1.2",
		"semver": "7.8.0",
		"typebox": "1.3.7",
		"undici": "8.10.2",
		"yaml": "2.9.0",
		"@earendil-works/pi-telemetry": "0.84.2"
	},
	"overrides": {
		"protobufjs": "7.6.5",
		"rimraf": "6.1.2",
		"gaxios": {
			"rimraf": "6.1.2"
		}
	},
	"optionalDependencies": {
		"@mariozechner/clipboard": "0.3.9"
	},
	"keywords": [
		"coding-agent",
		"ai",
		"llm",
		"cli",
		"tui",
		"agent"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/NeuroAIHub/BrainPilot.git",
		"directory": "packages/pi-sdk"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
